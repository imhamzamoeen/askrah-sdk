{
  "name": "@askrah/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for the AskRah referral platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.mjs",
      "require": "./dist/browser/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.mjs",
      "require": "./dist/events/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/browser/index.ts src/events/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/browser/index.ts src/events/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "askrah",
    "referral",
    "affiliate",
    "sdk",
    "typescript"
  ],
  "author": "AskRah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askrah/askrah-sdk.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "sideEffects": false
}
